desc:Granular Generator (control)
tags:utility
options:gmem=GranularGen
// Granular v0.2.0 - GENERATED by Granular.lua / tools/build.lua. Do not edit by hand.
// Audio passes through untouched. The sliders are read by the Granular action,
// which builds the grain items on this track's child tracks.
// Slider order is append-only (saved automation refers to slider numbers).

slider1:0<0,9999,1>Global: Seed
slider2:8<1,32,1>Global: Voices (tracks)
slider3:30<1,600,1>Global: Duration (s) if no time selection
slider4:1<0,1,1{Manual (use Regenerate),Auto}>Global: Update
slider5:0<0,1,1{Idle,Regenerate now}>Global: Regenerate
slider6:0<0,1,1{Leave alone,Mute}>Global: Source tracks
slider7:0<0,1,1{Keep,Overwrite}>Global: Hand-edited grains
slider8:0<0,2,1{Gap (s),Density (grains/s),Beats sync}>Timing: Mode
slider9:0.1<0,5,0.001>Timing: Gap after grain (s)
slider10:20<0.5,200,0.1>Timing: Density (grains/s)
slider11:4<0,9,1{1/32,1/16T,1/16,1/8T,1/8,1/4T,1/4,1/2,1/1,2/1}>Timing: Sync division
slider12:30<0,100,0.1>Timing: Randomize (%)
slider13:0<0,100,1>Timing: Grid snap (%)
slider14:0.15<0.005,5,0.001>Grain: Length (s)
slider15:30<0,100,0.1>Grain: Length randomize (%)
slider16:0<0,10,1{Off,1/32,1/16T,1/16,1/8T,1/8,1/4T,1/4,1/2,1/1,2/1}>Grain: Length sync
slider17:0.5<0,1,0.001>Source: Position (0-1)
slider18:0.5<0,1,0.001>Source: Position spread
slider19:0<-2,2,0.001>Source: Scan speed (x realtime)
slider20:1<0.1,4,0.001>Rate: Playrate
slider21:0<0,2,0.001>Rate: Spread (+/-)
slider22:0<0,100,1>Rate: Reverse probability (%)
slider23:0<0,4,1{Elastique Pro,SoundTouch,Rrreeaa,Rearearea,Resample (pitch follows rate)}>Pitch: Time-stretch mode
slider24:0<-48,48,0.01>Pitch: Offset (st)
slider25:0<0,24,0.01>Pitch: Spread (+/- st)
slider26:0<0,9,1{Off,Major,Minor,Harmonic minor,Dorian,Pentatonic maj,Pentatonic min,Whole tone,Blues,Fifths}>Pitch: Scale
slider27:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Pitch: Scale root
slider28:100<0,100,1>Pitch: Scale quantize (%)
slider29:0<0,1,1{Off,On}>PitchEnv: Enable
slider30:0<-12,12,0.01>PitchEnv: Start (st)
slider31:0<-12,12,0.01>PitchEnv: Middle (st)
slider32:0<-12,12,0.01>PitchEnv: End (st)
slider33:-6<-60,12,0.1>Amp: Gain (dB)
slider34:0<0,60,0.1>Amp: Gain spread (+/- dB)
slider35:20<0,100,0.1>Amp: Fade in (% of grain)
slider36:20<0,100,0.1>Amp: Fade out (% of grain)
slider37:0<0,6,1>Amp: Fade shape (0-6)
slider38:100<0,100,0.1>Amp: Grain probability (%)
slider39:0<-1,1,0.001>Pan: Centre
slider40:0<0,1,0.001>Pan: Spread (+/-)
slider41:0.5<0,1,0.001>Pan: Voice spread
slider42:0<0,1,1{Off,On}>PanEnv: Enable
slider43:0<-1,1,0.001>PanEnv: Start
slider44:0<-1,1,0.001>PanEnv: Middle
slider45:0<-1,1,0.001>PanEnv: End

@init
jsfx_version = 200;
last_hb = 0;
last_t = 0;

@gfx 420 46
t = time_precise();
hb = gmem[0];
hb != last_hb ? ( last_hb = hb; last_t = t; );
alive = (t - last_t) < 1.5;
engine_version = gmem[1];

gfx_x = 8; gfx_y = 6;
!alive ? (
  gfx_set(1, 0.6, 0.3, 1);
  gfx_drawstr("Granular v0.2.0 - engine NOT running (run the Granular action)");
) : engine_version != jsfx_version ? (
  gfx_set(1, 0.4, 0.4, 1);
  gfx_drawstr("Granular v0.2.0 - VERSION MISMATCH with the running engine");
) : (
  gfx_set(0.5, 1, 0.5, 1);
  gfx_drawstr("Granular v0.2.0 - engine running");
);
gfx_x = 8; gfx_y = 26;
gfx_set(0.8, 0.8, 0.8, 1);
gfx_drawstr("Open the Granular window for the full UI. Sliders here can be automated.");

